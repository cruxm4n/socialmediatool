# Copier ce fichier en .env.local puis compléter. Ne jamais versionner .env.local.
# Ne jamais coller une clé dans une conversation ou un ticket.

# --- Supabase -----------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API.
# La clé « publishable » est publique par nature : les droits sont appliqués par la base (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Secret d'automatisation --------------------------------------------------
# Chaîne aléatoire longue (ex. : openssl rand -base64 36).
# Son empreinte SHA-256 doit être enregistrée dans la base (voir supabase/seed.example.sql).
AUTOMATION_SECRET=

# --- Buffer -------------------------------------------------------------------
# « mock » (défaut) : Buffer simulé, aucun appel réseau. « real » : API Buffer.
BUFFER_MODE=mock
# Buffer > Settings > API. Reste côté serveur : jamais envoyée au navigateur.
BUFFER_API_KEY=
# Nom du tag Buffer qui soumet un brouillon au client.
BUFFER_REVIEW_TAG=À valider

# --- Comptes utilisés par les tests automatiques ------------------------------
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_INES_EMAIL=
DEMO_INES_PASSWORD=
DEMO_HUGO_EMAIL=
DEMO_HUGO_PASSWORD=
DEMO_SOFIA_EMAIL=
DEMO_SOFIA_PASSWORD=
