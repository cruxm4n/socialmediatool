# Copier ce fichier en .env.local puis compléter. Ne jamais versionner .env.local.
# Ne jamais coller une clé dans une conversation ou un ticket.

# --- Supabase -----------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API.
# La clé « publishable » est publique par nature : les droits sont appliqués par la base (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Secret d'automatisation --------------------------------------------------
# Chaîne aléatoire longue (ex. : openssl rand -base64 36).
# Son empreinte SHA-256 doit être enregistrée dans la base (voir supabase/seed.example.sql).
AUTOMATION_SECRET=

# --- Buffer -------------------------------------------------------------------
# « mock » (défaut) : Buffer simulé, aucun appel réseau. « real » : API Buffer.
BUFFER_MODE=mock
# Buffer > Settings > API. Reste côté serveur : jamais envoyée au navigateur.
BUFFER_API_KEY=
# Nom du tag Buffer qui soumet un brouillon au client.
BUFFER_REVIEW_TAG=À valider

# --- Synchronisation planifiée ---------------------------------------------------
# Intervalle du planificateur, en minutes. Défaut du code : 60 (prudent pour les quotas Buffer, propres à CHAQUE
# compte). Aucun planificateur n'est activé par ce fichier : voir docs/SYNCHRONISATION.md.
SYNC_INTERVAL_MINUTES=60

# --- Profil du déploiement ----------------------------------------------------------
# « pilot » (premier client) : notifications SIMULÉES et contenu MINIMAL imposés par le code, quelles que soient les
# variables ci-dessous ; un réglage contraire fait échouer GET /api/ready. Laisser vide en développement.
CADENCE_PROFILE=
# off : désactive la boucle du traitement urgent (suites de tests uniquement ; jamais en exploitation).
# URGENT_LOOP=off

# --- Notifications (voir docs/NOTIFICATIONS.md) -----------------------------------
# « simulate » (défaut) : aucun e-mail ne part, tout est tracé dans l'écran Notifications.
# « webhook » : envoi réel vers un récepteur compatible (n8n facultatif).
NOTIFICATIONS_MODE=simulate
# minimal (défaut) : aucun texte de publication ni commentaire dans les messages, un lien seulement.
# full : contenu inclus — déconseillé (voir DECISIONS.md D31).
NOTIFICATIONS_CONTENT=minimal
NOTIFICATIONS_WEBHOOK_URL=
NOTIFICATIONS_WEBHOOK_SECRET=
# Adresse publique de l'application, pour les liens des e-mails.
APP_URL=

# --- Comptes utilisés par les tests automatiques ------------------------------
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_INES_EMAIL=
DEMO_INES_PASSWORD=
DEMO_HUGO_EMAIL=
DEMO_HUGO_PASSWORD=
DEMO_SOFIA_EMAIL=
DEMO_SOFIA_PASSWORD=

# --- Base de test EXCLUSIVEMENT dédiée (DB/E2E écrivent des données) ------------
# URL distante différente de NEXT_PUBLIC_SUPABASE_URL ; jamais un projet de production.
# Appliquer les migrations et préparer les comptes uniquement sur ce projet de test.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_AUTOMATION_SECRET=
TEST_DEMO_ADMIN_EMAIL=
TEST_DEMO_ADMIN_PASSWORD=
TEST_DEMO_INES_EMAIL=
TEST_DEMO_INES_PASSWORD=
TEST_DEMO_HUGO_EMAIL=
TEST_DEMO_HUGO_PASSWORD=
TEST_DEMO_SOFIA_EMAIL=
TEST_DEMO_SOFIA_PASSWORD=

# Connexions fournisseur (migrations 0012 et 0013). BUFFER_API_KEY n'est PAS une clé par défaut : elle ne sert qu'à
# une éventuelle connexion historique « clé du serveur ». Chaque client a la clé de SON compte, saisie dans l'interface. Clé de chiffrement des clés Buffer enregistrées par client :
# 32 octets en base64 (openssl rand -base64 32). Jamais en base, jamais versionnée. Sans elle, aucune clé Buffer
# ne peut être enregistrée depuis l'interface. Voir docs/CONNEXIONS_FOURNISSEUR.md.
CADENCE_CREDENTIALS_KEY=

# Rotation de la clé maître (docs/CONNEXIONS_FOURNISSEUR.md) : numéro de la clé courante (1 par défaut), et anciennes
# clés encore nécessaires, « numéro:base64 » séparées par des virgules. À retirer une fois les clés re-chiffrées.
# CADENCE_CREDENTIALS_KEY_VERSION=1
# CADENCE_CREDENTIALS_PREVIOUS_KEYS=

# PRODUCTION — le Buffer simulé n'est jamais utilisé en silence. Un serveur de production utilise BUFFER_MODE=real.
# Pour une pile de test ou une démonstration tournant sur le build de production, il faut EN PLUS de BUFFER_MODE=mock :
# CADENCE_ALLOW_SIMULATED_BUFFER=1
#
# LECTURE SEULE — Cadence ne crée, ne modifie, ne programme et n'annule rien dans le vrai Buffer. L'ancienne variable
# CADENCE_BUFFER_WRITES n'est plus lue : la définir (même à « enabled ») n'a aucun effet.

# Développement : BUFFER_MODE=real est IGNORÉ par `npm run dev` (le Buffer simulé est utilisé), sauf si cette variable
# vaut 1. Ne jamais la définir dans un fichier partagé.
# CADENCE_ALLOW_REAL_BUFFER_IN_DEV=1
