# Copier ce fichier en .env.local puis compléter. Ne jamais versionner .env.local.
# Ne jamais coller une clé dans une conversation ou un ticket.

# --- Supabase -----------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API.
# La clé « publishable » est publique par nature : les droits sont appliqués par la base (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Secret d'automatisation --------------------------------------------------
# Chaîne aléatoire longue (ex. : openssl rand -base64 36).
# Son empreinte SHA-256 doit être enregistrée dans la base (voir supabase/seed.example.sql).
AUTOMATION_SECRET=

# --- Buffer -------------------------------------------------------------------
# « mock » (défaut) : Buffer simulé, aucun appel réseau. « real » : API Buffer.
BUFFER_MODE=mock
# Buffer > Settings > API. Reste côté serveur : jamais envoyée au navigateur.
BUFFER_API_KEY=
# Nom du tag Buffer qui soumet un brouillon au client.
BUFFER_REVIEW_TAG=À valider

# --- Synchronisation planifiée ---------------------------------------------------
# Intervalle du planificateur, en minutes (voir docs/PLANIFICATEUR.md). Sur l'offre gratuite de Buffer : 15 ou 30.
SYNC_INTERVAL_MINUTES=5

# --- Profil du déploiement ----------------------------------------------------------
# « pilot » (premier client) : notifications SIMULÉES et contenu MINIMAL imposés par le code, quelles que soient les
# variables ci-dessous ; un réglage contraire fait échouer GET /api/ready. Laisser vide en développement.
CADENCE_PROFILE=
# off : désactive la boucle du traitement urgent (suites de tests uniquement ; jamais en exploitation).
# URGENT_LOOP=off

# --- Notifications (voir docs/NOTIFICATIONS.md) -----------------------------------
# « simulate » (défaut) : aucun e-mail ne part, tout est tracé dans l'écran Notifications.
# « webhook » : envoi réel, par un workflow n8n.
NOTIFICATIONS_MODE=simulate
# minimal (défaut) : aucun texte de publication ni commentaire dans les messages, un lien seulement.
# full : contenu inclus — déconseillé (voir DECISIONS.md D31).
NOTIFICATIONS_CONTENT=minimal
NOTIFICATIONS_WEBHOOK_URL=
NOTIFICATIONS_WEBHOOK_SECRET=
# Adresse publique de l'application, pour les liens des e-mails.
APP_URL=

# --- Comptes utilisés par les tests automatiques ------------------------------
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_INES_EMAIL=
DEMO_INES_PASSWORD=
DEMO_HUGO_EMAIL=
DEMO_HUGO_PASSWORD=
DEMO_SOFIA_EMAIL=
DEMO_SOFIA_PASSWORD=

# --- Base de test EXCLUSIVEMENT dédiée (DB/E2E écrivent des données) ------------
# URL distante différente de NEXT_PUBLIC_SUPABASE_URL ; jamais un projet de production.
# Appliquer les migrations et préparer les comptes uniquement sur ce projet de test.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_AUTOMATION_SECRET=
TEST_DEMO_ADMIN_EMAIL=
TEST_DEMO_ADMIN_PASSWORD=
TEST_DEMO_INES_EMAIL=
TEST_DEMO_INES_PASSWORD=
TEST_DEMO_HUGO_EMAIL=
TEST_DEMO_HUGO_PASSWORD=
TEST_DEMO_SOFIA_EMAIL=
TEST_DEMO_SOFIA_PASSWORD=
