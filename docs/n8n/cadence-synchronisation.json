{
  "name": "Cadence — synchronisation Buffer (toutes les 5 minutes)",
  "active": false,
  "nodes": [
    {
      "id": "planification",
      "name": "Toutes les 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] } }
    },
    {
      "id": "appel",
      "name": "Demander la synchronisation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "parameters": {
        "method": "POST",
        "url": "http://ADRESSE-DE-CADENCE:3000/api/automation/sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 240000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "notesInFlow": true,
      "notes": "Identifiant « Header Auth » à créer dans n8n : nom x-automation-secret, valeur AUTOMATION_SECRET. Ne jamais écrire le secret dans ce nœud."
    },
    {
      "id": "controle",
      "name": "Échec ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "or",
          "conditions": [
            { "leftValue": "={{ $json.statusCode }}", "rightValue": 200, "operator": { "type": "number", "operation": "notEquals" } }
          ]
        }
      },
      "notesInFlow": true,
      "notes": "Branche « vrai » : brancher ici l'alerte de votre choix. Cadence affiche déjà l'échec dans Administration > Synchronisation."
    }
  ],
  "connections": {
    "Toutes les 5 minutes": { "main": [[{ "node": "Demander la synchronisation", "type": "main", "index": 0 }]] },
    "Demander la synchronisation": { "main": [[{ "node": "Échec ?", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "none" }
}
